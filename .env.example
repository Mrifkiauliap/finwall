# ===========================================================================
# Finwall — contoh konfigurasi environment
#
# Salin file ini menjadi `.env` lalu isi nilainya:
#   bash/zsh : cp .env.example .env
#   cmd      : copy .env.example .env
#
# Semua nilai divalidasi saat boot oleh `@finwall/config`. Variabel yang WAJIB
# dan dibiarkan kosong akan MENGGAGALKAN startup dengan pesan jelas — itu
# memang disengaja, supaya salah konfigurasi ketahuan langsung, bukan jadi bug
# misterius saat runtime.
#
# Membuat nilai acak yang aman (jalankan 3x untuk 3 secret berbeda):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Membuat ENCRYPTION_KEY (WAJIB base64 dari 32 byte, panjangnya tepat 44 char):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ===========================================================================

# ---------------------------------------------------------------------------
# Aplikasi
# ---------------------------------------------------------------------------
APP_PORT=3001
# WAJIB. Minimal 32 karakter.
APP_SECRET=
NODE_ENV="development"
LOG_LEVEL="info"

# ---------------------------------------------------------------------------
# JWT
#
# Nama variabel HARUS persis seperti ini (`_SECRET` dan `_EXPIRES_IN`) —
# schema memvalidasinya ketat, dan nilai yang salah nama akan diabaikan.
# ---------------------------------------------------------------------------
# WAJIB. Minimal 32 karakter.
JWT_ACCESS_SECRET=
# Format: angka + satuan s/m/h/d — mis. `15m`, `1d`.
JWT_ACCESS_EXPIRES_IN=15m
# WAJIB. Minimal 32 karakter.
# Di production WAJIB BERBEDA dari JWT_ACCESS_SECRET (divalidasi saat boot).
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Enkripsi
# ---------------------------------------------------------------------------
# WAJIB. Base64-encoded 32-byte key — panjangnya TEPAT 44 karakter.
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
#
# Semua punya default untuk development, tetapi di production `HOST`, `USER`,
# `PASSWORD`, dan `NAME` wajib diisi (divalidasi saat boot).
# ---------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=finwall

# ---------------------------------------------------------------------------
# Cache / session store (Valkey atau Redis)
#
# Dipakai untuk cache hot-path auth dan mirror session. Token sekali-pakai
# (verifikasi email, reset password) TIDAK disimpan di sini — itu di database.
# ---------------------------------------------------------------------------
VALKEY_HOST=localhost
VALKEY_PORT=6379

# ---------------------------------------------------------------------------
# Web (Vite / Nuxt) — dibaca oleh sisi klien
# ---------------------------------------------------------------------------
VITE_BASE_URL="/"
VITE_API_BASE_URL="http://localhost:3001"

# ---------------------------------------------------------------------------
# Email
#
# Dua provider didukung, dan RESEND_API_KEY MENANG atas SMTP:
#   1. Resend (disarankan di production) -> isi RESEND_API_KEY + EMAIL_FROM.
#   2. SMTP biasa / sumopod             -> isi EMAIL_HOST/PORT/USER/PASSWORD.
# ---------------------------------------------------------------------------
EMAIL_HOST="smtp.sumopod.com"
EMAIL_PORT=465
EMAIL_USER="no-reply"
# WAJIB (lihat catatan di atas) — boleh diisi placeholder bila memakai Resend.
EMAIL_PASSWORD=
# `true` untuk port 465 (TLS langsung).
# `false` untuk port 587 (STARTTLS) — harus ditulis huruf kecil.
EMAIL_SECURE=true
# Opsional. Alamat pengirim yang tampil di inbox, mis.
#   EMAIL_FROM="Finwall <no-reply@finwall.app>"
# WAJIB memakai domain yang sudah diverifikasi di Resend. Bila kosong, nilainya
# jatuh ke EMAIL_USER.
EMAIL_FROM=
# Opsional. Bila diisi, provider Resend yang dipakai dan SMTP diabaikan.
RESEND_API_KEY=

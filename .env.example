# Email — pilih salah satu:
# 1. Resend (disarankan di production): isi RESEND_API_KEY + EMAIL_FROM.
#    Jika RESEND_API_KEY ada, ia dipakai dan SMTP di bawah diabaikan.
# 2. SMTP biasa/sumopod: isi EMAIL_HOST/PORT/USER/PASSWORD.
# EMAIL_FROM wajib memakai domain yang sudah diverifikasi di Resend.
EMAIL_HOST="smtp.sumopod.com"
EMAIL_PORT=465
EMAIL_USER="no-reply"
EMAIL_PASSWORD=
EMAIL_SECURE=true
EMAIL_FROM=
RESEND_API_KEY=

